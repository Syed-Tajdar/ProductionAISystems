# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Supabase (Project Settings > API Keys). Use a secret key (sb_secret_...); server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
# Direct Postgres connection, used for migrations.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Speech to text
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Brand and product names to recognise on every call, comma-separated
DEEPGRAM_KEYTERMS=Harborline Insurance,Palm Crest Properties,Brightwave Internet
# Files posted straight to /calls. On Vercel set 4 (request bodies are limited to 4.5 MB).
MAX_UPLOAD_MB=100
# Larger files: the upload page sends them straight to this private Supabase Storage bucket
STORAGE_BUCKET=call-audio
STORAGE_MAX_MB=50
# Lifetime of the signed URL behind the audio player on the call page, in seconds.
AUDIO_URL_SECONDS=300
# background: answer at once, process afterwards. inline: process inside the request (Vercel, Cloud Run).
PROCESSING_MODE=background
# Price per audio minute from your Deepgram plan, for eval cost reporting
DEEPGRAM_PRICE_PER_MIN=

# LLM scoring: anthropic, openai or gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# Required when LLM_PROVIDER=openai
OPENAI_MODEL=
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash
GEMINI_MODEL=

# Retries on 429 and 5xx, and optional prices (USD per million tokens) for models
# without a built-in price, so cost per call is recorded
LLM_MAX_ATTEMPTS=3
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# One passcode for uploads, scoring and the dashboard; use a long random value.
# Without it those routes return 503.
APP_PASSCODE=
SESSION_HOURS=12
# Signs the session cookie; a long random value (openssl rand -base64 32). Empty = derived from the passcode alone.
SESSION_SECRET=
# Failed-login limit: auto (Postgres when Supabase is set), database or memory
LOGIN_LIMIT_STORE=auto
# Header with the client address set by the host's proxy (Vercel: x-real-ip); empty = socket address
CLIENT_IP_HEADER=
# Let visitors browse the calls marked is_demo without the passcode (read-only)
DEMO_MODE=false
# Reads without the passcode in demo mode: requests per client address per minute (0 = no limit)
PUBLIC_READS_PER_MINUTE=60

# "Back to portfolio" link in the dashboard header
PORTFOLIO_URL=https://syed-tajdar.vercel.app
