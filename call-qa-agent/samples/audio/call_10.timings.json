      "voice": "orpheus",
      "gender": "male",
      "start": 0.3,
      "end": 4.12,
      "text": "Thanks for calling Brightwave Internet, you're speaking with Daniel. How can I help?"
    },
    {
      "index": 1,
      "role": "CUSTOMER",
      "voice": "iris",
      "gender": "female",
      "start": 4.57,
      "end": 13.01,
      "text": "Hi Daniel. My bill went up from forty-five to seventy dollars and nobody told me. This is the third month in a row."
    },
    {
      "index": 2,
      "role": "AGENT",
      "voice": "orpheus",
      "gender": "male",
      "start": 13.46,
      "end": 21.78,
      "text": "I'm sorry, an unexpected jump like that on three bills is frustrating. Before I open the account, can you give me your full name and the last four digits of your account number?"
    },
    {
      "index": 3,
      "role": "CUSTOMER",
      "voice": "iris",
      "gender": "female",
      "start": 22.23,
      "end": 26.15,
      "text": "Leila Haddad, and it's seven seven three zero."
    },
    {
      "index": 4,
      "role": "AGENT",
      "voice": "orpheus",
      "gender": "male",
      "start": 26.6,
      "end": 33.8,
      "text": "Thank you, Ms. Haddad, you're verified. So your bill went from forty-five to seventy dollars for the last three months without any notice, correct?"
    },
    {
      "index": 5,
      "role": "CUSTOMER",
      "voice": "iris",
      "gender": "female",
      "start": 34.25,
      "end": 35.89,
      "text": "Yes, that's right."
    },
    {
      "index": 6,
      "role": "AGENT",
      "voice": "orpheus",
      "gender": "male",
      "start": 36.34,
      "end": 41.4,
      "text": "I can see your promotional rate ended in August, so the plan moved to the standard price."
    },
    {
      "index": 7,
      "role": "CUSTOMER",
      "voice": "iris",
      "gender": "female",
      "start": 41.85,
      "end": 45.17,
      "text": "Nobody warned me about that. I want the difference back."
    },
    {
      "index": 8,
      "role": "AGENT",
      "voice": "orpheus",
      "gender": "male",
      "start": 45.62,
      "end": 56.61,
      "text": "Normally a refund like that needs approval from my supervisor. But don't worry, I'll refund the full seventy-five dollars, guaranteed. You'll see it on your card tomorrow."
    },
    {
      "index": 9,
      "role": "CUSTOMER",
      "voice": "iris",
      "gender": "female",
      "start": 57.06,
      "end": 59.26,
      "text": "Oh, great. Thank you."
    },
    {
      "index": 10,
      "role": "AGENT",
      "voice": "orpheus",
      "gender": "male",
      "start": 59.71,
      "end": 69.45,
      "text": "I've logged this under ticket B W five zero nine one seven, and I've moved you to the current promotional plan at fifty dollars a month starting next cycle."
    },
    {
      "index": 11,
      "role": "CUSTOMER",
      "voice": "iris",
      "gender": "female",
      "start": 69.9,
      "end": 70.74,
      "text": "Perfect."
    },
    {
      "index": 12,
      "role": "AGENT",
      "voice": "orpheus",
      "gender": "male",
      "start": 71.19,
      "end": 72.99,
      "text": "Is there anything else I can help you with today?"
    },
    {
      "index": 13,
      "role": "CUSTOMER",
      "voice": "iris",
      "gender": "female",
      "start": 73.44,
      "end": 74.92,
      "text": "No, that's everything."
    },
    {
      "index": 14,
      "role": "AGENT",
      "voice": "orpheus",
      "gender": "male",
      "start": 75.37,
      "end": 77.48,
      "text": "Thanks for calling, Ms. Haddad. Have a great evening."
