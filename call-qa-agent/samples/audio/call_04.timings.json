    {
      "index": 10,
      "role": "AGENT",
      "voice": "andromeda",
      "gender": "female",
      "start": 44.52,
      "end": 48.92,
      "text": "Sure, sure. I'll just send over the details and give you a call next week to go over them."
    },
    {
      "index": 11,
      "role": "CUSTOMER",
      "voice": "zeus",
      "gender": "male",
      "start": 49.37,
