# Copy to .env for local Docker. On Railway or Render, set the same names as
# service variables (see DEPLOY.md). Never commit .env.

N8N_VERSION=2.45.0

# n8n's own database (not the leads data). n8n 2.x supports Postgres 17+.
POSTGRES_VERSION=17
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=n8n

# Create once with `openssl rand -hex 32` and keep a copy outside the server.
N8N_ENCRYPTION_KEY=

# Local defaults. Hosted: N8N_HOST=your-domain, N8N_PROTOCOL=https,
# N8N_WEBHOOK_URL=https://your-domain/, N8N_SECURE_COOKIE=true, N8N_PROXY_HOPS=1
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0
N8N_HOST_PORT=5678
# "::" listens on IPv6 and IPv4 (needed for Railway private networking).
# Set 0.0.0.0 if the container fails with "address '::' is not available".
N8N_LISTEN_ADDRESS=::

GENERIC_TIMEZONE=Asia/Dubai

# Settings whose defaults change in n8n 3.0, fixed so an upgrade changes nothing
# (DEPLOY.md, "Pinned n8n settings"). docker-compose.yml sets the same values.
N8N_UNVERIFIED_PACKAGES_ENABLED=false
# internal: n8n starts the Code node runner itself. external needs a second container.
N8N_RUNNERS_MODE=internal
# Seconds a Code node may run. Kept at 300: an LLM call on a cold start can take over 60 s.
N8N_RUNNERS_TASK_TIMEOUT=300
# No workflow here uses the Compression node; these are n8n 3.0's limits (256 MiB, 1,000 entries).
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000
# Hours of execution history to keep (336 = 14 days)
EXECUTIONS_DATA_MAX_AGE=336

# Credentials used inside n8n workflows are created in the n8n UI
# (Supabase service role key, LLM key, Telegram bot token, SMTP/Gmail).
# They are stored encrypted in n8n's database, not in this file.

# Lead workflow settings, read by the workflows through $env (N8N_BLOCK_ENV_ACCESS_IN_NODE=false).
LEADS_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
LEADS_BUSINESS_NAME=Palm Grove Realty
# Telegram chat ids: sales gets hot leads and the daily summary, ops gets failures.
LEADS_SALES_CHAT_ID=
LEADS_OPS_CHAT_ID=
# Sender of auto-replies and follow-ups. Empty = no emails are sent.
LEADS_EMAIL_FROM=Palm Grove Realty <hello@example.com>
LEADS_EMAIL_REPLY_TO=
# Country code for local numbers such as 050 000 0101.
LEADS_DEFAULT_COUNTRY_CODE=971
# Public demo only: emails are returned in the response instead of sent, submissions and alerts are capped.
LEADS_DEMO_MODE=false
LEADS_DEMO_PER_VISITOR=5
LEADS_DEMO_WINDOW_MINUTES=10
LEADS_DEMO_DAILY_CAP=100
LEADS_DEMO_ALERTS_PER_DAY=20
# Header trusted for the visitor's address in the demo limits. Render: cf-connecting-ip (set by Cloudflare in front
# of every public service). Use a header your own proxy overwrites, never one a caller can set.
LEADS_CLIENT_IP_HEADER=cf-connecting-ip

# Local email testing (Mailpit). In n8n, create the SMTP credential with host mailpit,
# port 1025, SSL off, no user. Sent emails appear at http://localhost:8025.
MAILPIT_VERSION=v1.33.0
MAILPIT_UI_PORT=8025
