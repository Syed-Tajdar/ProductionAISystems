# Postgres with pgvector. Supabase on a serverless host: Connect > Transaction pooler (port 6543).
# Local: docker run -d -e POSTGRES_PASSWORD=dev -p 55433:5432 pgvector/pgvector:pg17
DATABASE_URL=postgresql://postgres:dev@localhost:55433/postgres
# Connections open on demand and close after this many idle seconds
DB_POOL_MAX=3
DB_POOL_MAX_IDLE_SECONDS=30
DOCUMENTS_DIR=documents

CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# Embeddings (Gemini). Must match vector(768) in the migration.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=100
# The free tier returned 429 after about 11 requests in 40 seconds; 10 a minute stays under it.
EMBEDDING_REQUESTS_PER_MINUTE=10

# Answers (Claude)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
ANSWER_EFFORT=medium

# Cross-language retrieval: translate the question for a second keyword search
QUERY_TRANSLATION=true
TRANSLATION_MODEL=claude-haiku-5-5
MAX_PER_DOCUMENT=3

# Evals only: the model that grades answers
JUDGE_MODEL=claude-opus-5-5

# Public demo limits (page, /ask, /search and the public /mcp together). auto: in Postgres when
# DATABASE_URL is set, so they hold across serverless instances; memory: per process
DEMO_STORE=auto
DEMO_QUESTIONS_PER_CLIENT=5
DEMO_WINDOW_SECONDS=600
DEMO_DAILY_CAP=150
ANSWER_CACHE_SIZE=200
ANSWER_CACHE_SECONDS=86400
# Header with the client address set by the host's proxy (Vercel: x-real-ip); empty = socket address
CLIENT_IP_HEADER=

TOP_K=6
SEARCH_CANDIDATES=20
RRF_K=60

# MCP over streamable HTTP at /mcp on the web app (and for rag-mcp --transport http).
# MCP_BEARER_TOKEN set: private, every request needs it (at least 24 characters, e.g. openssl rand -hex 32).
# Otherwise MCP_PUBLIC=true: public read-only demo without a token, under the demo limits above.
MCP_BEARER_TOKEN=
MCP_PUBLIC=false

# "Back to portfolio" link in the page header
PORTFOLIO_URL=https://syed-tajdar.vercel.app
