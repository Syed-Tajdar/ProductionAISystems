# Checklist of values to enter in n8n. n8n stores credentials encrypted in its
# own database; this file is never loaded automatically. Never commit real values.

# Credential "Anthropic API" (type Header Auth): name = x-api-key, value = key
ANTHROPIC_API_KEY=

# Credential "Gmail" (type Gmail OAuth2): client ID and secret from Google Cloud
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Credential "Gemini API" (type Header Auth): name = x-goog-api-key, value = key
# Only needed when llm_provider is gemini.
GEMINI_API_KEY=

# Credential "Telegram Bot" (type Telegram API)
TELEGRAM_BOT_TOKEN=

# Credential "Triage webhook token" (type Header Auth): name = X-Webhook-Token
TRIAGE_WEBHOOK_TOKEN=

# Settings block (also llm_provider: anthropic | gemini, and gemini_model) in the "Normalize email" node
TELEGRAM_URGENT_CHAT_ID=
# Optional Gmail label IDs per category, e.g. Label_123456789
GMAIL_LABEL_ID_URGENT=

# Tests only: the local test bench
N8N_TEST_URL=http://localhost:5679
