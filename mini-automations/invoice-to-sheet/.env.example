# Live mode only. Dry run (--dry-run) needs none of these.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5 (claude-haiku-5-5 is cheaper, less accurate on messy PDFs)
ANTHROPIC_MODEL=

# Provider: anthropic (default) or gemini
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=

# Google Sheets output (skip if you use --csv)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Invoices
