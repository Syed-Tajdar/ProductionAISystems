# Checklist of values to enter in n8n. n8n stores credentials encrypted in its
# own database; this file is never loaded automatically. Never commit real values.

# Credential "Anthropic API" (type Header Auth): name = x-api-key, value = key
ANTHROPIC_API_KEY=

# Credential "WhatsApp Cloud API" (type Header Auth): name = Authorization, value = "Bearer <token>"
WHATSAPP_ACCESS_TOKEN=

# n8n server environment (not a credential): Meta app secret for the signature check,
# plus NODE_FUNCTION_ALLOW_BUILTIN=crypto and N8N_BLOCK_ENV_ACCESS_IN_NODE=false
WHATSAPP_APP_SECRET=
# Optional: turns dry runs on; requests must send it in the X-Dry-Run-Token header. Unset = dry runs refused.
WHATSAPP_DRY_RUN_TOKEN=

# Settings block (also llm_provider: anthropic | gemini, and gemini_model) at the top of the "Parse message" node
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_SALES_CHAT_ID=

# "Check verify token" node; the same string goes into the Meta webhook setup
WHATSAPP_VERIFY_TOKEN=

# Credential "Gemini API" (type Header Auth): name = x-goog-api-key, value = key
# Only needed when llm_provider is gemini.
GEMINI_API_KEY=

# Credential "Telegram Bot" (type Telegram API)
TELEGRAM_BOT_TOKEN=

# Tests only: the local test bench
N8N_TEST_URL=http://localhost:5679
