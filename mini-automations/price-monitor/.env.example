# Live mode only. Dry run (--dry-run) needs none of these.

# Only used for pages without JSON-LD or meta price tags
ANTHROPIC_API_KEY=
# Optional, defaults to claude-haiku-5-5
ANTHROPIC_MODEL=

# Provider: anthropic (default) or gemini
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash-lite
GEMINI_MODEL=

# Telegram bot from BotFather, and the chat (or group) that receives alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
