# Checklist of values to enter in n8n. n8n stores credentials encrypted in its
# own database; this file is never loaded automatically. Never commit real values.

# Credential "Google Sheets" (type Google Sheets OAuth2 API): OAuth client from Google Cloud
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Credential "HubSpot private app" (type Header Auth): name = Authorization, value = "Bearer <token>"
# Private app scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=

# Credential "Sync webhook token" (type Header Auth): name = X-Webhook-Token
SYNC_WEBHOOK_TOKEN=

# Settings block in the "Prepare run" node
GOOGLE_SPREADSHEET_ID=

# Tests only: the local test bench
N8N_TEST_URL=http://localhost:5679
