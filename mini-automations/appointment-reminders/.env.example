# Checklist of values to enter in n8n. n8n stores credentials encrypted in its
# own database; this file is never loaded automatically. Never commit real values.

# Credential "Supabase" (type Custom Auth), JSON:
# {"headers": {"apikey": "<service role key>", "Authorization": "Bearer <service role key>"}}
SUPABASE_SERVICE_ROLE_KEY=

# Credential "WhatsApp Cloud API" (type Header Auth): name = Authorization, value = "Bearer <token>"
WHATSAPP_ACCESS_TOKEN=

# Credential "Reminders webhook token" (type Header Auth): name = X-Webhook-Token
REMINDERS_WEBHOOK_TOKEN=

# Settings block in the "Prepare run" node
SUPABASE_URL=https://your-project.supabase.co
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=appointment_reminder

# Tests only: the local test bench
N8N_TEST_URL=http://localhost:5679
