      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "07c86140-986a-5668-9872-326c0ccba899",
              "leftValue": "={{ !$json.dry_run && $json.reminders.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "a454b0c3-8cd6-593a-8e14-9a8416ef952d",
      "name": "Split reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        -60
      ],
      "parameters": {
        "jsCode": "return $input.first().json.reminders.map((r) => ({ json: r }));\n"
      }
    },
    {
      "id": "a8e94df8-641b-5ab3-8b97-a22a0a6d443c",
      "name": "Send WhatsApp reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Prepare run').first().json.settings.graph_api_version }}/{{ $('Prepare run').first().json.settings.whatsapp_phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.whatsapp_body) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mnWhatsAppToken01",
          "name": "WhatsApp Cloud API"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "90aebfa0-f456-582a-9e37-32a9556f3dc5",
      "name": "Check sends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -60
      ],
      "parameters": {
        "jsCode": "const sent = $('Split reminders').all().map((item, i) => {\n  const res = $input.all()[i]?.json || {};\n  return { ...item.json, message_id: res.messages?.[0]?.id || null, error: res.error ? (res.error.message || 'send failed') : null };\n});\nconst ok = sent.filter((r) => r.message_id);\nconst updates = ['24h', '2h']\n  .map((type) => ({ type, ids: ok.filter((r) => r.type === type).map((r) => r.appointment_id) }))\n  .filter((u) => u.ids.length);\nreturn [{ json: {\n  sent: ok.map(({ appointment_id, type, message_id }) => ({ appointment_id, type, message_id })),\n  failed: sent.filter((r) => !r.message_id).map(({ appointment_id, type, error }) => ({ appointment_id, type, error })),\n  updates,\n} }];\n"
      }
    },
    {
      "id": "2cf49712-5146-5c05-9dc6-a121cc3d2d03",
      "name": "Any sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        -60
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "eb94e60b-7edb-5d83-85c7-b493a1ee0322",
              "leftValue": "={{ $json.updates.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "d1a54528-c7d1-54b2-9e0f-de28844a94b0",
      "name": "Build updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        -140
      ],
      "parameters": {
        "jsCode": "const now = new Date().toISOString();\nreturn $input.first().json.updates.map((u) => ({ json: {\n  filter: `in.(${u.ids.join(',')})`,\n  patch: { [u.type === '24h' ? 'reminder_24h_sent_at' : 'reminder_2h_sent_at']: now },\n} }));\n"
      }
    },
    {
      "id": "db703fdd-52e5-5a0c-9888-3f3f3aefdd62",
      "name": "Mark as sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1940,
        -140
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Prepare run').first().json.settings.supabase_url }}/rest/v1/appointments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ $json.filter }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.patch) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "mnSupabaseKeys001",
          "name": "Supabase"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true
    },
    {
      "id": "7cc5cab4-b15e-5a90-91bf-40de6d304151",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        40
      ],
      "parameters": {
        "jsCode": "const picked = $('Pick reminders').first().json;\nlet sends = { sent: [], failed: [] };\ntry { sends = $('Check sends').first().json; } catch (e) { /* nothing was sent this run */ }\nreturn [{ json: {\n  ...picked,\n  sent: sends.sent,\n  failed: sends.failed,\n  counts: { checked: picked.checked, due: picked.reminders.length, sent: sends.sent.length, failed: sends.failed.length, skipped: picked.skipped.length },\n} }];\n"
      },
      "executeOnce": true
    },
    {
